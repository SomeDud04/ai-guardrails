{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/nasi-lemak/owasp-llm-top10-2026/record.schema.json",
  "title": "OWASP LLM Top 10 2026 synthetic payload record",
  "description": "One JSONL record for the Nasi Lemak manual checklist. optional_extra is merged into the gateway request body; keys beginning with '$' are fixture markers for the tester and are never sent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "category_name",
    "title",
    "coverage",
    "technique",
    "severity",
    "messages",
    "optional_extra",
    "guard_expect",
    "expect_status",
    "expect_code",
    "expect_behaviour",
    "control",
    "evidence",
    "needs_guard_model",
    "reference"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(LLM(0[1-9]|10)-[0-9]{3}|CTRL-[0-9]{3})$"
    },
    "category": {
      "type": "string",
      "enum": ["LLM01", "LLM02", "LLM03", "LLM04", "LLM05", "LLM06", "LLM07", "LLM08", "LLM09", "LLM10", "CTRL"]
    },
    "category_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "coverage": {
      "type": "string",
      "enum": ["direct", "boundary", "known-gap", "not-applicable", "benign-control"]
    },
    "technique": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[-/+][a-z0-9]+)*$"
    },
    "severity": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low", "Info"]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["user", "assistant", "system"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "optional_extra": {
      "type": ["object", "null"],
      "description": "Fields merged into the request body, or null. '$'-prefixed keys are fixture markers and are not sent."
    },
    "guard_expect": {
      "type": "string",
      "enum": ["should_block", "should_allow", "unverified"]
    },
    "expect_status": {
      "type": "integer",
      "enum": [200, 400, 403, 413]
    },
    "expect_code": {
      "type": ["string", "null"],
      "enum": [null, "INVALID_REQUEST", "INPUT_LIMIT", "POLICY_BLOCK"]
    },
    "expect_behaviour": {"type": "string", "minLength": 20},
    "control": {"type": "string", "minLength": 3},
    "evidence": {"type": "string", "minLength": 20},
    "needs_guard_model": {"type": "boolean"},
    "reference": {
      "type": "string",
      "pattern": "^(OWASP LLM(0[1-9]|10):2026 p\\.[0-9]{1,3}|Nasi Lemak control baseline \\(internal\\))$"
    },
    "notes": {"type": ["string", "null"]}
  }
}
