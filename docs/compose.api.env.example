# Nonsecret example for the opt-in API guard backend overlay.
#
# Combine AFTER the base env file, never instead of it:
#
#   docker compose \
#     --env-file .secrets/compose.env \
#     --env-file .secrets/compose.api.env \
#     -f compose.yaml -f compose.api.yaml config
#
# Only paths, URLs, model IDs and validated tunables belong here.  Never put an
# API key, a DSN containing a password, an application/operator key or a key
# digest in this file, Git, chat or shell history.

# --- Approved policy (read-only bind mount) --------------------------------
# One operator-approved YAML policy file.  The installer never rewrites this
# operator-owned file; preserve each approved version under a new path.
API_POLICY_FILE=/ABSOLUTE/PATH/TO/policy/2026-10-20.1.yaml

# --- Input classifier (gateway-owned contract v1) --------------------------
# The serving wrapper must implement nasi-lemak-input-classifier-v1.  Do not
# substitute a stock Prompt Guard endpoint that lacks this contract.
NASI_LEMAK_INPUT_GUARD_URL=https://input-guard.example.invalid/v1
NASI_LEMAK_INPUT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
NASI_LEMAK_INPUT_GUARD_AUTH=bearer
NASI_LEMAK_INPUT_GUARD_THRESHOLD=0.5
# Required only for bearer auth.  INPUT_GUARD_KEY_SOURCE_FILE is the host path
# mounted as a Compose secret; the runtime path below is inside the container.
# For auth=none omit BOTH NASI_LEMAK_INPUT_GUARD_API_KEY_FILE and provide any
# readable file (or the installer's dedicated empty secret) as the source.
INPUT_GUARD_KEY_SOURCE_FILE=/ABSOLUTE/PATH/TO/.secrets/input_guard_key
NASI_LEMAK_INPUT_GUARD_API_KEY_FILE=/run/secrets/input_guard_key

# --- Output classifier (Qwen3Guard chat completions) -----------------------
NASI_LEMAK_OUTPUT_GUARD_URL=https://output-guard.example.invalid/v1
NASI_LEMAK_OUTPUT_GUARD_MODEL=Qwen/Qwen3Guard-Gen-4B
NASI_LEMAK_OUTPUT_GUARD_AUTH=bearer
# Required only for bearer auth; omit for auth=none as described above.
OUTPUT_GUARD_KEY_SOURCE_FILE=/ABSOLUTE/PATH/TO/.secrets/output_guard_key
NASI_LEMAK_OUTPUT_GUARD_API_KEY_FILE=/run/secrets/output_guard_key

# --- Optional validated transport settings ---------------------------------
# Keep TLS verification enabled.  For a private CA, use compose.api-ca.yaml
# and set GUARD_CA_BUNDLE instead of disabling verification.  Plain HTTP is an
# explicit, acknowledged test-only opt-in; it is not a production default.
# NASI_LEMAK_INPUT_GUARD_TIMEOUT=10
# NASI_LEMAK_INPUT_GUARD_MAX_RESPONSE_BYTES=8192
# NASI_LEMAK_INPUT_GUARD_ALLOW_INSECURE_HTTP=false
# NASI_LEMAK_OUTPUT_GUARD_TIMEOUT=10
# NASI_LEMAK_OUTPUT_GUARD_MAX_RESPONSE_BYTES=8192
# NASI_LEMAK_OUTPUT_GUARD_ALLOW_INSECURE_HTTP=false

# --- Private CA (compose.api-ca.yaml only) ---------------------------------
# GUARD_CA_BUNDLE=/ABSOLUTE/PATH/TO/private-ca-bundle.pem

# --- Distinct operator reader credentials ----------------------------------
# Reuse the existing test/pilot pattern.  The operator key digest must differ
# from the chat application key digest; the operator audit DSN is the
# read-only reader-role DSN and must differ from the runtime writer DSN.
OPERATOR_KEY_DIGEST_FILE=/ABSOLUTE/PATH/TO/.secrets/operator_key_digest
OPERATOR_AUDIT_DSN_FILE=/ABSOLUTE/PATH/TO/.secrets/operator_audit_dsn
