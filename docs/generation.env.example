# Non-secret example settings for the direct OpenAI-compatible generation client.
# Copy values into your shell environment; do not treat this file as a live config.
# Never put a real API key in this repository.

# User-supplied endpoint. The root host is http://82haf69n.flexinfra.com.my.
# /v1 is the assumed OpenAI-compatible prefix; it has NOT been live-verified.
# The client appends /chat/completions or /models itself and never adds /v1.
NASI_LEMAK_GENERATION_URL=http://82haf69n.flexinfra.com.my/v1

# No Authorization header is sent. A stale key variable is ignored in this mode.
# Use "bearer" plus NASI_LEMAK_GENERATION_API_KEY for a keyed endpoint.
NASI_LEMAK_GENERATION_AUTH=none

# Explicit opt-in required for this non-loopback plain-HTTP endpoint.
# TLS verification is never disabled, and HTTPS remains the default.
NASI_LEMAK_GENERATION_ALLOW_INSECURE_HTTP=true

# Exact provider model ID is still unknown and must not be invented.
# Listing models works without it; generation fails closed while it is blank.
# A reasoning-style model can spend a tiny max_tokens budget on hidden
# reasoning and return blank content. The client rejects that generically and
# never reads reasoning_content or retries; use an adequate request budget and
# a model that returns ordinary assistant content.
NASI_LEMAK_GENERATION_MODEL=

# Optional:
# NASI_LEMAK_GENERATION_TIMEOUT=60
# NASI_LEMAK_GENERATION_MAX_RESPONSE_BYTES=262144

# Optional server-side concise-reply instruction. Unset preserves the existing
# request body exactly. When set, it is prepended as one system message to the
# upstream payload only; guard scans, audit and the output scan context keep the
# caller's sanitized conversation. Validation: non-empty, no control characters
# and at most 1000 characters.
# NASI_LEMAK_GENERATION_SYSTEM_PROMPT=Answer concisely, in at most about 200 words, unless the user asks for more detail.

# Optional provider-specific Qwen chat-template switch. Unset preserves the
# existing request body. When set, only
# chat_template_kwargs.enable_thinking=true|false is forwarded. Some reasoning
# models may still return blank content, and this client never reads
# reasoning_content, retries or raises the budget. Whether a given provider
# honours this option has NOT been live-verified; confirm it with a supervised
# response before relying on it.
# NASI_LEMAK_GENERATION_ENABLE_THINKING=false
