# Nonsecret example for `docker compose --env-file ...`.
#
# Copy to a LOCAL, untracked env file (for example .secrets/compose.env) and
# replace every /ABSOLUTE/PATH placeholder with the real path to a secret file.
# The referenced files must exist before `docker compose up`.
#
# This file contains only secret FILE PATH placeholders for credentials and
# key material.  Never put the password itself, a DSN containing a password, an
# application key, or its digest in this file, in Git, or in chat/history.
# The .secrets/ directory is ignored by both Git and Docker.

# --- Mandatory secret-file paths -------------------------------------------
# Text file containing only the PostgreSQL administrator password (no quotes,
# no trailing newline).  Read by PostgreSQL through POSTGRES_PASSWORD_FILE.
DB_ADMIN_PASSWORD_FILE=/ABSOLUTE/PATH/TO/.secrets/db_admin_password

# Text file containing one runtime (writer-role) PostgreSQL DSN, for example:
#   postgresql://nasi_lemak_gateway:<interactive-password>@db:5432/nasi_lemak
# It must NOT be the administrator DSN.  Create it locally after provisioning
# the LOGIN role with `\password`; never paste it into a shell command, chat or
# the repository.
AUDIT_DSN_FILE=/ABSOLUTE/PATH/TO/.secrets/audit_dsn

# Text file containing only the lowercase 64-hex SHA-256 digest of the
# application key.  The plaintext application key is held by the approved
# client/secret manager and is not mounted into this stack.
APP_KEY_DIGEST_FILE=/ABSOLUTE/PATH/TO/.secrets/app_key_digest

# --- Nonsecret deployment settings -----------------------------------------
# Database administrator name (not a password).  Set deliberately; there is no
# usable fallback if it is missing.
POSTGRES_ADMIN_USER=nasi_lemak_admin

# Host loopback port for the gateway.  The container always listens on 8000.
GATEWAY_PORT=8000

# --- Nonsecret generation transport settings -------------------------------
# Supplied HTTP-only endpoint.  /v1 is an ASSUMED OpenAI-compatible prefix and
# has not been live-verified.  Plain HTTP is accepted only with the explicit
# opt-in below; TLS remains required for any non-loopback HTTPS endpoint in
# normal operation, and certificate verification is never disabled.
# These values are non-secret; no API key belongs here.
NASI_LEMAK_GENERATION_URL=http://82haf69n.flexinfra.com.my/v1
NASI_LEMAK_GENERATION_AUTH=none
NASI_LEMAK_GENERATION_ALLOW_INSECURE_HTTP=true

# Exact provider model ID remains unknown and must not be invented.
NASI_LEMAK_GENERATION_MODEL=
