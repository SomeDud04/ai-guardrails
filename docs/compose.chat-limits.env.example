# Optional non-secret chat context/reply limits.
#
# Combine this file AFTER every existing env file, never instead of them:
#
#   docker compose \
#     --env-file .secrets/compose.env \
#     --env-file .secrets/compose.test.env \
#     --env-file .secrets/compose.chat-limits.env \
#     -f compose.yaml -f compose.test.yaml config
#
# The base Compose file declares these four names as bare pass-through
# entries.  Unset values keep the validated application defaults shown below;
# invalid or out-of-range values leave the app live but not ready rather than
# being silently replaced.  The context budget uses conservative UTF-8 units,
# not model tokenizer tokens.  These are not provider-capacity claims.
#
# Create the deployed copy once, without overwriting an existing file:
#   test -e .secrets/compose.chat-limits.env || \
#     cp docs/compose.chat-limits.env.example .secrets/compose.chat-limits.env
#   chmod 600 .secrets/compose.chat-limits.env

# Maximum number of messages in the selected context window (1..32).
NASI_LEMAK_CHAT_CONTEXT_MESSAGES=32

# Conservative serialized-context budget in UTF-8 units (1..32768).
NASI_LEMAK_CHAT_CONTEXT_BUDGET=8192

# Default requested reply length in provider tokens (1..max reply).
NASI_LEMAK_CHAT_DEFAULT_REPLY_TOKENS=1024

# Maximum accepted requested reply length in provider tokens (1..8192).
NASI_LEMAK_CHAT_MAX_REPLY_TOKENS=4096
