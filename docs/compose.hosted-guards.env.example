# Nonsecret example for the opt-in hosted guard pair (Groq input, Cloudflare
# output).  This is NOT the default API guard contract and NOT install.sh JSON
# v1: it is applied manually with compose.api.yaml.
#
# Combine AFTER the base env file and this file, never instead of it:
#
#   docker compose \
#     --env-file .secrets/compose.env \
#     --env-file .secrets/compose.hosted-guards.env \
#     -f compose.yaml -f compose.api.yaml config
#
# Add the workspace, CA and existing demo/nginx overlays only when they are
# already part of the deployment (see docs/hosted-guard-setup.md).  Never combine
# compose.api.yaml with compose.test.yaml or compose.pilot.yaml.
#
# Only paths, URLs, model IDs and validated tunables belong here.  Never put an
# API key, a DSN containing a password, an application/operator key or a key
# digest in this file, Git, chat or shell history.

# --- Approved policy and operator files (existing pattern) -----------------
API_POLICY_FILE=/ABSOLUTE/PATH/TO/policy/2026-10-20.1.yaml
OPERATOR_KEY_DIGEST_FILE=/ABSOLUTE/PATH/TO/.secrets/operator_key_digest
OPERATOR_AUDIT_DSN_FILE=/ABSOLUTE/PATH/TO/.secrets/operator_audit_dsn

# --- Hosted provider pair (both selectors are mandatory together) ----------
# Omitting both keeps the old custom /classify input contract plus Qwen3Guard
# output.  Setting only one, or any other value, leaves the app unready.
NASI_LEMAK_INPUT_GUARD_PROVIDER=groq-prompt-guard
NASI_LEMAK_OUTPUT_GUARD_PROVIDER=cloudflare-llama-guard

# --- Groq Prompt Guard 2 86M input -----------------------------------------
# Exact documented model ID.  Do not substitute the 22M model or an LLM label
# classifier.  The adapter requires a single numeric probability in [0, 1].
NASI_LEMAK_INPUT_GUARD_URL=https://api.groq.com/openai/v1
NASI_LEMAK_INPUT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
NASI_LEMAK_INPUT_GUARD_AUTH=bearer
# Uncalibrated starting threshold, not an accuracy claim.  The adapter blocks
# at or above this value.
NASI_LEMAK_INPUT_GUARD_THRESHOLD=0.5
# Host path mounted as a Compose secret; the runtime path is inside the
# container.  Create the host file without putting the key in shell history.
INPUT_GUARD_KEY_SOURCE_FILE=/ABSOLUTE/PATH/TO/.secrets/input_guard_key
NASI_LEMAK_INPUT_GUARD_API_KEY_FILE=/run/secrets/input_guard_key

# --- Cloudflare Workers AI Llama Guard 3 8B output -------------------------
# Replace ACCOUNT_ID with the real Cloudflare account identifier.  The base URL
# keeps the /ai/v1 path; the adapter appends /chat/completions.  The exact model
# ID must be echoed by the provider or the adapter fails closed.
NASI_LEMAK_OUTPUT_GUARD_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1
NASI_LEMAK_OUTPUT_GUARD_MODEL=@cf/meta/llama-guard-3-8b
NASI_LEMAK_OUTPUT_GUARD_AUTH=bearer
OUTPUT_GUARD_KEY_SOURCE_FILE=/ABSOLUTE/PATH/TO/.secrets/output_guard_key
NASI_LEMAK_OUTPUT_GUARD_API_KEY_FILE=/run/secrets/output_guard_key

# --- Optional validated transport settings ---------------------------------
# Keep TLS verification enabled.  For a private CA use compose.api-ca.yaml and
# GUARD_CA_BUNDLE instead of disabling verification.  Plain HTTP is an explicit
# test-only opt-in, not a production default.
# NASI_LEMAK_INPUT_GUARD_TIMEOUT=10
# NASI_LEMAK_INPUT_GUARD_MAX_RESPONSE_BYTES=8192
# NASI_LEMAK_INPUT_GUARD_ALLOW_INSECURE_HTTP=false
# NASI_LEMAK_OUTPUT_GUARD_TIMEOUT=10
# NASI_LEMAK_OUTPUT_GUARD_MAX_RESPONSE_BYTES=8192
# NASI_LEMAK_OUTPUT_GUARD_ALLOW_INSECURE_HTTP=false

# --- Private CA (compose.api-ca.yaml only) ---------------------------------
# GUARD_CA_BUNDLE=/ABSOLUTE/PATH/TO/private-ca-bundle.pem
