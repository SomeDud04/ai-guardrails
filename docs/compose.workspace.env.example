# Optional non-secret overlay environment for the employee workspace.
#
# Combine this file AFTER the base and mode env files, never instead of them:
#
#   docker compose \
#     --env-file .secrets/compose.env \
#     --env-file .secrets/compose.test.env \
#     --env-file .secrets/compose.workspace.env \
#     -f compose.yaml -f compose.test.yaml -f compose.workspace.yaml config
#
# This file contains only secret FILE PATH placeholders and the explicit
# HTTP decision.  Never put a DSN containing a password, the key itself, or a
# password in this file, Git, chat or shell history.

# Restricted runtime DSN file.  The LOGIN account is a member of the fixed
# nasi_lemak_workspace group only, and this file is readable by UID 10001.
# Replace with the real absolute host path; the file must exist before `up`.
WORKSPACE_DSN_FILE=/ABSOLUTE/PATH/TO/.secrets/workspace/workspace_dsn

# Stable Fernet key file, mode 0400 and owned by 10001:10001.  Back it up
# separately from the database.  Never regenerate it on update and never print
# or paste its contents.
WORKSPACE_KEY_FILE=/ABSOLUTE/PATH/TO/.secrets/workspace/workspace_key

# Explicit transport decision.  Compose defaults to false when this line is
# absent.  The current trusted-LAN demo is plain HTTP, so this opt-in is set to
# true for that demo only.  Set it to false, or remove this line, for any
# deployment that has reviewed HTTPS ingress.
NASI_LEMAK_WORKSPACE_ALLOW_HTTP=true
