# Optional non-secret overlay environment for the test-mode profile.
#
# Combine this file AFTER the base env file, never instead of it:
#
#   docker compose \
#     --env-file .secrets/compose.env \
#     --env-file .secrets/compose.test.env \
#     -f compose.yaml -f compose.test.yaml config
#
# This profile selects the lightweight server image and explicitly disables the
# native guard classifiers. It is useful for integration testing against a real
# generation endpoint with guard verdicts inactive. It is not a guarded pilot.
#
# Later --env-file entries win for duplicate keys. This file intentionally
# contains NO generation/model settings, so the base values are not overridden.

# --- Read-only test policy (host path) --------------------------------------
# One operator-approved YAML policy file (see docs/policy.example.yaml).
TEST_POLICY_FILE=/ABSOLUTE/PATH/TO/policy/test-policy.yaml

# --- Distinct operator secret FILE paths ------------------------------------
# operator_key_digest: lowercase 64-hex SHA-256 digest of the operator key.
# operator_audit_dsn: read-only reader-role PostgreSQL DSN. It must differ
# from the runtime writer DSN in AUDIT_DSN_FILE.
OPERATOR_KEY_DIGEST_FILE=/ABSOLUTE/PATH/TO/.secrets/operator_key_digest
OPERATOR_AUDIT_DSN_FILE=/ABSOLUTE/PATH/TO/.secrets/operator_audit_dsn
